# Copy thành scan_relay.env trên máy Windows IT — KHÔNG commit scan_relay.env

# --- scan_relay_server.py (bật nền, portal bấm Quét gọi vào đây) ---
EQUIPMENT_RELAY_SECRET=your-agent-secret
EQUIPMENT_RELAY_BIND=0.0.0.0
EQUIPMENT_RELAY_PORT=8765

# --- scan_relay.py (quét theo lịch, tuỳ chọn) ---
EQUIPMENT_RELAY_URL=https://portal.justplay.vn
EQUIPMENT_AGENT_SECRET=your-agent-secret
SCAN_START_IP=192.168.1.1
SCAN_END_IP=192.168.1.254
SCAN_USER=JUSTPLAY\it-admin
SCAN_PASS=
