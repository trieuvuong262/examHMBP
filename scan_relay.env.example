# Copy thành scan_relay.env trên máy Windows IT (cùng thư mục scan_relay.py)
# KHÔNG commit scan_relay.env — chứa mật khẩu domain admin

# URL portal (HTTPS public hoặc Tailscale IP VPS)
EQUIPMENT_RELAY_URL=https://portal.justplay.vn
# Khớp EQUIPMENT_AGENT_SECRET trong .env trên VPS
EQUIPMENT_AGENT_SECRET=your-agent-secret

# Dải IP LAN công ty (tối đa 255 IP/lần)
SCAN_START_IP=192.168.1.1
SCAN_END_IP=192.168.1.254

# Tài khoản domain có quyền WMI remote (vd. JUSTPLAY\it-admin)
SCAN_USER=JUSTPLAY\it-admin
SCAN_PASS=

# Tuỳ chọn
# SCAN_MAX_HOSTS=255
