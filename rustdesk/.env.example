# Sao chép thành .env trên VPS: cp .env.example .env
#
# Host công khai mà client RustDesk trỏ tới (DNS A record → VPS).
RUSTDESK_PUBLIC_HOST=co.justplay.vn

# IP VPS (để /etc/hosts trên server khi DNS chưa propagate)
RUSTDESK_VPS_IP=103.90.224.203

# Ghim phiên bản image — đừng dùng :latest trên production
RUSTDESK_IMAGE=rustdesk/rustdesk-server:1.1.14

# Y = mọi phiên đi qua relay (hbbr) — dễ kiểm soát, tránh P2P lách firewall nội bộ
ALWAYS_USE_RELAY=Y

# Giới hạn RAM mỗi container (tránh ảnh hưởng Portal trên cùng VPS)
HBBS_MEM_LIMIT=256m
HBBR_MEM_LIMIT=512m
