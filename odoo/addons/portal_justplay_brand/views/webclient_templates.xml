<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="justplay_web_favicon" inherit_id="web.layout" name="JustPlay Favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="icon" type="image/png" sizes="16x16" href="/portal_justplay_brand/static/img/favicon-16.png"/>
            <link rel="icon" type="image/png" sizes="32x32" href="/portal_justplay_brand/static/img/favicon-32.png"/>
            <link rel="shortcut icon" type="image/png" href="/portal_justplay_brand/static/img/favicon-32.png"/>
        </xpath>
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"/>
        </xpath>
    </template>

    <template id="justplay_frontend_fonts" inherit_id="web.frontend_layout" name="JustPlay Frontend Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
