# Odoo Phase 0 — erp.justplay.vn
ODOO_IMAGE=odoo:18.0
ODOO_PUBLIC_HOST=erp.justplay.vn

# PostgreSQL (container riêng, không dùng DB Portal)
ODOO_DB_NAME=postgres
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-strong-db-password

# Master password Odoo (màn hình tạo database / quản trị)
ODOO_ADMIN_PASSWORD=change-me-strong-admin-password

# Portal nginx proxy (để script setup-ssl-erp.sh biết project Portal)
PORTAL_PROJECT_DIR=/opt/portaljustplay
SSL_EMAIL=it@justplay.vn
