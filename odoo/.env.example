# Odoo Phase 0 — erp.justplay.vn
ODOO_IMAGE=odoo:18.0
ODOO_PUBLIC_HOST=erp.justplay.vn

# PostgreSQL (container riêng, không dùng DB Portal)
ODOO_DB_NAME=postgres
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me-strong-db-password

# Master password Odoo (màn hình tạo database / quản trị)
ODOO_ADMIN_PASSWORD=change-me-strong-admin-password

# SSO Portal → Odoo (cùng giá trị ODOO_SSO_SECRET trên Portal .env)
PORTAL_SSO_SECRET=change-me-long-random-secret
ODOO_PILOT_DB=justplay_pilot

# LDAP (Synology Directory Server) — Odoo auth_ldap
# Odoo chỉ hỗ trợ ldap:// + STARTTLS; NAS Synology dùng cổng 389 (không TLS) qua Tailscale.
ODOO_LDAP_ENABLE=0
ODOO_LDAP_SERVER=100.93.5.42
ODOO_LDAP_PORT=389
ODOO_LDAP_TLS=0
ODOO_LDAP_BASE_DN=dc=ldap,dc=justplay,dc=local
ODOO_LDAP_BIND_DN=uid=root,cn=users,dc=ldap,dc=justplay,dc=local
ODOO_LDAP_BIND_PASSWORD=
ODOO_LDAP_FILTER=(uid=%s)
ODOO_LDAP_CREATE_USER=1

# Portal nginx proxy (để script setup-ssl-erp.sh biết project Portal)
PORTAL_PROJECT_DIR=/opt/portaljustplay
SSL_EMAIL=it@justplay.vn
