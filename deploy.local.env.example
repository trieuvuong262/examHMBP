# Sao chép thành deploy.local.env (file này KHÔNG commit lên Git)
# Dùng cho publish.ps1 / publish.sh — SSH lên VPS chạy deploy.sh sau khi git push

VPS_HOST=103.90.224.203
VPS_USER=root
VPS_PORT=22
PROJECT_DIR=/opt/portaljustplay
BRANCH=main

# 1 = sau push sẽ SSH chạy ./deploy.sh (cần VPS_HOST + SSH key)
DEPLOY_AFTER_PUSH=1
