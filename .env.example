# Production / Docker (VPS)
DJANGO_ENV=production
DEBUG=False
RUNNING_IN_DOCKER=1

# Docker Compose .env: ký tự $ phải viết $$ (vd SECRET_KEY=...$$gvb...)
SECRET_KEY=your-production-secret-key
SERVER_IP=103.90.224.203
PORTAL_DOMAIN=portal.justplay.vn
ALLOWED_HOSTS=103.90.224.203,portal.justplay.vn,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://103.90.224.203,https://103.90.224.203,http://portal.justplay.vn,https://portal.justplay.vn

# 0 = HTTP (tắt cookie Secure). Đặt 1 sau khi cài SSL: scripts/setup-ssl.sh
# Lưu ý: USE_HTTPS=1 mà truy cập bằng http://IP → lỗi CSRF 403
USE_HTTPS=0

DB_NAME=portaljustplay_db
DB_USER=postgres
DB_PASSWORD=123123
DB_HOST=db
DB_PORT=5432

# Google Gemini — Hỏi đáp Thư viện (/tai-lieu/hoi-dap/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NAS — mount rclone trên VPS (production)
NAS_MOUNT_ROOT=/mnt/nas-portal
NAS_RCLONE_REMOTE=synology:DATACHUNG
NAS_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
NAS_AUTO_SYNC_INTERVAL=15
NAS_SHARE_EXPIRE_DAYS=30

# Quản lý thiết bị — tem QR & quét WMI
PORTAL_PUBLIC_BASE_URL=http://127.0.0.1:8000
EQUIPMENT_TAG_HEADER=JUSTPLAY — QUẢN LÝ THIẾT BỊ
# Bật màn hình bắt buộc cài agent cho user mới (Windows, chưa có trong quản lý thiết bị)
EQUIPMENT_REQUIRE_AGENT_INSTALL=1
# Chỉ các username này không bị chặn (phân tách bằng dấu phẩy)
EQUIPMENT_AGENT_GATE_EXEMPT_USERNAMES=admin
# Secret — Agent EXE trên từng PC + VPS (justplay_agent.ini)
EQUIPMENT_AGENT_SECRET=your-agent-secret
# EQUIPMENT_AGENT_EXE_PATH=/path/to/JustPlayAgent.exe  # tuỳ chọn; mặc định static/equipment/
# Portal production → gọi relay quét trên máy IT (Tailscale IP, vd http://100.x.x.x:8765)
EQUIPMENT_RELAY_HTTP_URL=
EQUIPMENT_RELAY_SECRET=
EQUIPMENT_RELAY_TIMEOUT=300
# Gợi ý trên form quét (tuỳ chọn)
EQUIPMENT_SCAN_DEFAULT_USER=JUSTPLAY\\it-admin
EQUIPMENT_SCAN_DEFAULT_START_IP=192.168.1.1
EQUIPMENT_SCAN_DEFAULT_END_IP=192.168.1.254
# Email thông báo thiết bị (phân tách bằng dấu phẩy; bổ sung ngoài email nhân viên phòng IT)
EQUIPMENT_NOTIFY_EMAILS=it@justplay.vn
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@portal.justplay.vn
# Production SMTP (bỏ comment khi deploy):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Deploy: tự xóa file media không còn tham chiếu (avatar/tài liệu đang dùng được giữ)
CLEANUP_ORPHAN_MEDIA=1
