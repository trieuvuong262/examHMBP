# Production / Docker (VPS)
DJANGO_ENV=production
DEBUG=False
RUNNING_IN_DOCKER=1

# Docker Compose .env: ký tự $ phải viết $$ (vd SECRET_KEY=...$$gvb...)
SECRET_KEY=your-production-secret-key
SERVER_IP=103.90.224.203
PORTAL_DOMAIN=portal.justplay.vn
ALLOWED_HOSTS=103.90.224.203,portal.justplay.vn,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://103.90.224.203,https://103.90.224.203,http://portal.justplay.vn,https://portal.justplay.vn

# 0 = HTTP (tắt cookie Secure). Đặt 1 sau khi cài SSL: scripts/setup-ssl.sh
# Lưu ý: USE_HTTPS=1 mà truy cập bằng http://IP → lỗi CSRF 403
USE_HTTPS=0

# Đăng nhập — khóa tài khoản sau N lần sai (mặc định 10); IP không tự chặn khi sai mật khẩu
LOGIN_LOCK_MAX_ATTEMPTS=10
# Ngưỡng gợi ý blacklist IP trên trang Quản trị (không tự chặn)
LOGIN_IP_BLOCK_MAX_ATTEMPTS=10
PORTAL_IT_CONTACT=Phòng IT Just Play — ext / email nội bộ
# Chỉ bật khi cần Django tự redirect HTTP→HTTPS (thường để 0 — nginx/ssl.conf xử lý)
# SECURE_SSL_REDIRECT=1

DB_NAME=portaljustplay_db
DB_USER=postgres
DB_PASSWORD=123123
DB_HOST=db
DB_PORT=5432

# CKEditor 4 LTS (4.25.1+) — license từ CKSource; để trống = 4.22.1 + ẩn banner bảo mật
CKEDITOR_LTS_LICENSE_KEY=

# Google Gemini — Hỏi đáp Thư viện (/tai-lieu/hoi-dap/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NAS — mount rclone trên VPS (production)
NAS_MOUNT_ROOT=/mnt/nas-portal
NAS_RCLONE_REMOTE=synology:
NAS_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# Phòng ban có share NAS riêng (gốc remote, không nằm dưới DATACHUNG)
NAS_DEPT_ROOT_REMOTES=KD-MKT:synology:KD-MKT
NAS_DEPT_MOUNT_ROOTS=KD-MKT:/mnt/nas-kd-mkt
NAS_LISTING_CACHE_SECONDS=120
NAS_RCLONE_FAST_LIST=1
NAS_AUTO_SYNC_INTERVAL=60
NAS_BACKGROUND_SYNC_DEFAULT=0
# Backup tự động 00:00/ngày (cron: scripts/setup-backup-cron.sh) + nút Nhật ký thao tác
NAS_BACKUP_RCLONE_REMOTE=synology:backup
NAS_BACKUP_REL_PATH=
NAS_BACKUP_RETENTION_DAYS=30
# Giám sát NAS (DSM Web API — tab Performance CPU/RAM/tiến trình)
# Cổng DSM: Control Panel → Login Portal → Web Services (KHÔNG phải tab Advanced của External Access)
NAS_DSM_URL=https://100.93.5.42:5556
NAS_DSM_ACCOUNT=tailscale-justplay
NAS_DSM_PASSWORD=
NAS_DSM_CRED_FILE=/root/.nas-cred
NAS_DSM_VERIFY_SSL=0
NAS_WEEKLY_REPORT_REL_PATH=99_LUU_TRU/1.2026/BAO_CAO_TUAN
NAS_DAILY_REPORT_REL_PATH=99_LUU_TRU/1.2026/BAO_CAO_NGAY
NAS_ANNOUNCEMENT_REL_PATH=99_LUU_TRU/1.2026/THONG_BAO
HOST_PROJECT_DIR=/opt/portaljustplay
PORTAL_BACKUP_SOURCE_DIRS=/app,/backup-source
PORTAL_BACKUP_INCLUDE_MEDIA=1

# Quản lý thiết bị — tem QR
PORTAL_PUBLIC_BASE_URL=http://127.0.0.1:8000
EQUIPMENT_TAG_HEADER=JUSTPLAY — QUẢN LÝ THIẾT BỊ
# Email thông báo thiết bị (phân tách bằng dấu phẩy; bổ sung ngoài email nhân viên phòng IT)
EQUIPMENT_NOTIFY_EMAILS=it@justplay.vn

# RustDesk self-host + script cai dat tu dong
RUSTDESK_PUBLIC_HOST=rd.justplay.vn
RUSTDESK_PUBLIC_KEY=
RUSTDESK_CLIENT_PASSWORD=
RUSTDESK_ENROLL_SECRET=

# Wake-on-LAN — relay NAS trong LAN (scripts/JustPlay-WoL-Relay.py)
# VPS gọi URL này; NAS gửi magic packet. Dùng IP Tailscale NAS nếu VPS ở internet.
# RUSTDESK_WOL_RELAY_URL=http://100.x.x.x:39280/wake
# RUSTDESK_WOL_RELAY_SECRET=
# RUSTDESK_WOL_BROADCAST=192.168.2.255

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@portal.justplay.vn
# Production SMTP (bỏ comment khi deploy):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1

# Deploy: tự xóa file media không còn tham chiếu (avatar/tài liệu đang dùng được giữ)
CLEANUP_ORPHAN_MEDIA=1

# KiotViet Public API — Thiết lập → Cửa hàng → Kết nối API (xem docs/integrations/kiotviet/)
KIOTVIET_ENABLED=0
KIOTVIET_RETAILER=your-store-slug
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_TOKEN_URL=https://id.kiotviet.vn/connect/token
KIOTVIET_API_BASE_URL=https://public.kiotapi.com
KIOTVIET_USE_LOCAL_MIRROR=1
KIOTVIET_SYNC_PAGE_SIZE=100
KIOTVIET_API_TIMEOUT=90
KIOTVIET_API_TIMEOUT_ORDERS=180

# Zalo OA / ZBS — OTP quên mật khẩu (docs/integrations/zalo/README.md)
ZALO_ENABLED=0
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OTP_TEMPLATE_ID=
ZALO_OTP_TEMPLATE_PARAM=otp
ZALO_DEVELOPMENT_MODE=1
ZALO_REFRESH_TOKEN=
# ZALO_CODE_VERIFIER=
ZALO_OTP_TTL_SECONDS=300
ZALO_OTP_LENGTH=6
ZALO_OTP_MAX_ATTEMPTS=5
ZALO_OTP_COOLDOWN_SECONDS=60
ZALO_OTP_MAX_PER_HOUR=5
# (P2) TTL / độ dài / số lần thử OTP quên mật khẩu — xem settings ZALO_OTP_*

# Web Push — nhắc đặt cơm (python manage.py generate_webpush_vapid_keys)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_CLAIMS_EMAIL=mailto:it@justplay.vn

# Odoo ERP — đồng bộ tài khoản (XML-RPC)
ODOO_URL=https://erp.justplay.vn
ODOO_PUBLIC_URL=https://erp.justplay.vn
ODOO_DB=justplay_pilot
ODOO_API_USER=admin
ODOO_API_PASSWORD=
ODOO_VERIFY_SSL=1
ODOO_DEFAULT_GROUPS=base.group_user,stock.group_stock_user,mrp.group_mrp_user
ODOO_MANAGER_GROUPS=stock.group_stock_manager,mrp.group_mrp_manager
# SSO Portal → Odoo (cùng secret với portal_sso_secret trong /opt/odoo/config/odoo.conf)
ODOO_SSO_SECRET=
ODOO_SSO_TTL_SECONDS=120

# NAS LDAP — đồng bộ tài khoản Portal → Synology Directory Server
NAS_LDAP_SYNC_ENABLED=0
# NAS_LDAP_HOST=100.93.5.42
# NAS_LDAP_PORT=636
# NAS_LDAP_BASE_DN=dc=ldap,dc=justplay,dc=local
# NAS_LDAP_BIND_DN=uid=root,cn=users,dc=ldap,dc=justplay,dc=local
# NAS_LDAP_BIND_PASSWORD=
# NAS_LDAP_SYNC_SKIP_USERNAMES=admin,ductn
# NAS_LDAP_DOMAIN=ldap.justplay.local
# NAS_RDRIVE_SERVER=justplay.synology.me
# NAS_SMB_PORT=445
# NAS_WEBDAV_PORT=5678
# (NAS_RDRIVE_PORT cũ — nếu set 5678 sẽ bị bỏ qua vì đó là WebDAV)
# Share ẩn khỏi Duyệt thư mục Portal + Quét từ NAS (mặc định: docker,backup,log)
# NAS_PORTAL_BROWSE_HIDDEN_SHARES=docker,backup,log
# Áp dụng phân quyền share lên DSM (SSH admin)
# NAS_SSH_HOST=100.93.5.42
# NAS_SSH_ADMIN_USER=admin
# NAS_SSH_ADMIN_PASSWORD=

# Module Sản xuất — cổng quy trình (off | warn | block). Mặc định: block
# SX_GATE_REQUIRE_RELEASE_BEFORE_ISSUE=block
# SX_GATE_REQUIRE_ISSUE_BEFORE_STAT=block
# SX_GATE_REQUIRE_QC_PASS_BEFORE_FG=block
# SX_GATE_REQUIRE_STAT_BEFORE_FG=block
# SX_TRACE_MIN_TIMELINE_EVENTS=4
