# Production / Docker (VPS)
DJANGO_ENV=production
DEBUG=False
RUNNING_IN_DOCKER=1

# Docker Compose .env: ký tự $ phải viết $$ (vd SECRET_KEY=...$$gvb...)
SECRET_KEY=your-production-secret-key
SERVER_IP=103.90.224.203
PORTAL_DOMAIN=portal.justplay.vn
ALLOWED_HOSTS=103.90.224.203,portal.justplay.vn,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://103.90.224.203,https://103.90.224.203,http://portal.justplay.vn,https://portal.justplay.vn

# 0 = HTTP (tắt cookie Secure). Đặt 1 sau khi cài SSL: scripts/setup-ssl.sh
# Lưu ý: USE_HTTPS=1 mà truy cập bằng http://IP → lỗi CSRF 403
USE_HTTPS=0

DB_NAME=portaljustplay_db
DB_USER=postgres
DB_PASSWORD=123123
DB_HOST=db
DB_PORT=5432

# Google Gemini — Hỏi đáp Thư viện (/tai-lieu/hoi-dap/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NAS — mount rclone trên VPS (production)
NAS_MOUNT_ROOT=/mnt/nas-portal
NAS_RCLONE_REMOTE=synology:DATACHUNG
NAS_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
NAS_AUTO_SYNC_INTERVAL=15
NAS_SHARE_EXPIRE_DAYS=30

# Quản lý thiết bị — tem QR & agent WMI
PORTAL_PUBLIC_BASE_URL=http://127.0.0.1:8000
EQUIPMENT_TAG_HEADER=JUSTPLAY — QUẢN LÝ THIẾT BỊ
EQUIPMENT_AGENT_SECRET=your-agent-secret

# Deploy: tự xóa file media không còn tham chiếu (avatar/tài liệu đang dùng được giữ)
CLEANUP_ORPHAN_MEDIA=1
