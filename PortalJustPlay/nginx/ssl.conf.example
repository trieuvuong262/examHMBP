# Copy thành ssl.conf sau khi có chứng chỉ: scripts/setup-ssl.sh
# Hoặc: cp PortalJustPlay/nginx/ssl.conf.example PortalJustPlay/nginx/ssl.conf

server {
    listen 443 ssl;
    http2 on;
    server_name portal.justplay.vn;

    ssl_certificate /etc/letsencrypt/live/portal.justplay.vn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.justplay.vn/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 20M;

    include /etc/nginx/conf.d/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://django_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    location /media/ {
        alias /app/media/;
    }
}
