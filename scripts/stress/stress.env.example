# Copy thanh stress.env va dien tai khoan test (khong commit stress.env)
#   copy stress.env.example stress.env

# URL portal (local hoac VPS)
STRESS_BASE_URL=https://portal.justplay.vn

# Tai khoan test: can quyen Bao cao, Yeu cau, Kho NPL
STRESS_USER=loadtest
STRESS_PASS=doi_mat_khau_day

# So user ao dong thoi & thoi gian giu tai
STRESS_VUS=10
STRESS_DURATION=3m
STRESS_RAMP=30s

# Nghi giua moi vong lap (giay)
STRESS_SLEEP_MIN=2
STRESS_SLEEP_MAX=5
